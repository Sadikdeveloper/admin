# Optional API origin. Empty or unset uses same-origin URLs and lets
# the dev server / reverse proxy forward /admin to the backend.
VITE_API_BASE_URL=

# Dev server only: when set, Vite proxies API paths to this backend address, so
# the browser can keep using relative URLs (required for remote previews).
# VITE_DEV_API_PROXY=http://127.0.0.1:3000
# Comma-separated paths to proxy when VITE_DEV_API_PROXY is set (default: /admin).
# VITE_DEV_PROXY_PATHS=/admin,/blog,/mock-media

# Dev only: install a fake injected wallet (see src/dev/mock-wallet.ts) so the
# console can sign in without a wallet extension — pair with mock/blog-api.mjs.
# VITE_MOCK_WALLET=1
# VITE_MOCK_WALLET_ADDRESS=0x1111111111111111111111111111111111111111

# Public marketing site, used for "View live post" and "Copy link" in the blog CMS.
# VITE_PUBLIC_SITE_URL=https://rown.xyz
